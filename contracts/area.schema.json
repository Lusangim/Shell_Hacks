{
  "$defs": {
    "Accuracy": {
      "enum": [
        "exact",
        "approximate",
        "unknown"
      ],
      "title": "Accuracy",
      "type": "string"
    },
    "Band": {
      "enum": [
        "touching",
        "lt_1_6km",
        "lt_8km",
        "lt_40km"
      ],
      "title": "Band",
      "type": "string"
    },
    "Center": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Center",
      "type": "object"
    },
    "LineGeometry": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 180,
                "minimum": -180,
                "type": "number"
              },
              {
                "maximum": 90,
                "minimum": -90,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "LineString",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "LineGeometry",
      "type": "object"
    },
    "MultiLineGeometry": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 180,
                  "minimum": -180,
                  "type": "number"
                },
                {
                  "maximum": 90,
                  "minimum": -90,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "minItems": 2,
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "MultiLineString",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "MultiLineGeometry",
      "type": "object"
    },
    "Overlap": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "title": "A",
          "type": "string"
        },
        "a_name": {
          "title": "A Name",
          "type": "string"
        },
        "a_utility": {
          "minLength": 1,
          "title": "A Utility",
          "type": "string"
        },
        "a_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "A Year"
        },
        "accuracy_pair": {
          "$ref": "#/$defs/Accuracy"
        },
        "b": {
          "title": "B",
          "type": "string"
        },
        "b_name": {
          "title": "B Name",
          "type": "string"
        },
        "b_utility": {
          "minLength": 1,
          "title": "B Utility",
          "type": "string"
        },
        "b_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "B Year"
        },
        "band": {
          "$ref": "#/$defs/Band"
        },
        "band_label": {
          "title": "Band Label",
          "type": "string"
        },
        "brief_status": {
          "enum": [
            "cached",
            "stale",
            "template",
            "none"
          ],
          "title": "Brief Status",
          "type": "string"
        },
        "can_share": {
          "title": "Can Share",
          "type": "string"
        },
        "cross_state": {
          "title": "Cross State",
          "type": "boolean"
        },
        "distance_km": {
          "exclusiveMaximum": 40,
          "minimum": 0,
          "title": "Distance Km",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "pair_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pair Note"
        },
        "rank": {
          "exclusiveMinimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "savings": {
          "$ref": "#/$defs/Savings"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "timeline": {
          "title": "Timeline",
          "type": "string"
        },
        "touch_detail": {
          "title": "Touch Detail",
          "type": "string"
        },
        "touch_reason": {
          "enum": [
            "same_substation",
            "shared_endpoint",
            "lines_cross",
            "proximity",
            "same_area_approximate"
          ],
          "title": "Touch Reason",
          "type": "string"
        },
        "year_gap": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Year Gap"
        }
      },
      "required": [
        "id",
        "a",
        "b",
        "a_utility",
        "b_utility",
        "a_name",
        "b_name",
        "distance_km",
        "band",
        "band_label",
        "touch_reason",
        "touch_detail",
        "can_share",
        "a_year",
        "b_year",
        "year_gap",
        "timeline",
        "cross_state",
        "pair_note",
        "accuracy_pair",
        "score",
        "rank",
        "savings",
        "brief_status"
      ],
      "title": "Overlap",
      "type": "object"
    },
    "PointGeometry": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "Point",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "PointGeometry",
      "type": "object"
    },
    "ProjectFeature": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/PointGeometry"
            },
            {
              "$ref": "#/$defs/LineGeometry"
            },
            {
              "$ref": "#/$defs/MultiLineGeometry"
            },
            {
              "type": "null"
            }
          ],
          "title": "Geometry"
        },
        "properties": {
          "$ref": "#/$defs/ProjectProperties"
        },
        "type": {
          "const": "Feature",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "geometry",
        "properties"
      ],
      "title": "ProjectFeature",
      "type": "object"
    },
    "ProjectProperties": {
      "additionalProperties": false,
      "properties": {
        "accuracy": {
          "$ref": "#/$defs/Accuracy"
        },
        "cost_basis": {
          "enum": [
            "plan",
            "proxy",
            "none"
          ],
          "title": "Cost Basis",
          "type": "string"
        },
        "cost_flags": {
          "items": {
            "enum": [
              "printed_total_differs_from_sum",
              "below_list_threshold"
            ],
            "type": "string"
          },
          "title": "Cost Flags",
          "type": "array"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Usd"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        },
        "endpoints": {
          "items": {
            "type": "string"
          },
          "title": "Endpoints",
          "type": "array"
        },
        "id": {
          "pattern": "^(desc-p[1-9][0-9]*|sertp-p[1-9][0-9]*-[0-9a-f]{6}(?:-[2-9][0-9]*)?)$",
          "title": "Id",
          "type": "string"
        },
        "in_service": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "In Service"
        },
        "location_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Location Source"
        },
        "miles": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Miles"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "need": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Need"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Project Id"
        },
        "project_type": {
          "enum": [
            "new_line",
            "rebuild_line",
            "reconductor",
            "new_substation",
            "substation_upgrade",
            "equipment",
            "other"
          ],
          "title": "Project Type",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "GA",
                "SC"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "State"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        },
        "utility": {
          "minLength": 1,
          "title": "Utility",
          "type": "string"
        },
        "utility_basis": {
          "enum": [
            "stated",
            "inferred_from_location"
          ],
          "title": "Utility Basis",
          "type": "string"
        },
        "voltage_kv": {
          "items": {
            "type": "number"
          },
          "title": "Voltage Kv",
          "type": "array"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 2200,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Year"
        }
      },
      "required": [
        "id",
        "project_id",
        "utility",
        "utility_basis",
        "name",
        "description",
        "need",
        "status",
        "in_service",
        "year",
        "cost_usd",
        "cost_basis",
        "cost_flags",
        "project_type",
        "miles",
        "endpoints",
        "state",
        "accuracy",
        "location_source",
        "source"
      ],
      "title": "ProjectProperties",
      "type": "object"
    },
    "Savings": {
      "additionalProperties": false,
      "properties": {
        "assumption_ids": {
          "items": {
            "type": "string"
          },
          "title": "Assumption Ids",
          "type": "array"
        },
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Basis"
        },
        "high_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "High Usd"
        },
        "low_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Low Usd"
        },
        "status": {
          "enum": [
            "range",
            "timing_too_far",
            "no_cost",
            "unknown_year"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "low_usd",
        "high_usd",
        "basis",
        "assumption_ids"
      ],
      "title": "Savings",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "doc": {
          "minLength": 1,
          "title": "Doc",
          "type": "string"
        },
        "page": {
          "exclusiveMinimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "doc",
        "page",
        "url"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "center": {
      "$ref": "#/$defs/Center"
    },
    "counts_by_band": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/Band"
      },
      "title": "Counts By Band",
      "type": "object"
    },
    "counts_by_utility": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Counts By Utility",
      "type": "object"
    },
    "overlaps": {
      "items": {
        "$ref": "#/$defs/Overlap"
      },
      "title": "Overlaps",
      "type": "array"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/ProjectFeature"
      },
      "title": "Projects",
      "type": "array"
    },
    "radius_km": {
      "maximum": 80,
      "minimum": 1,
      "title": "Radius Km",
      "type": "number"
    }
  },
  "required": [
    "center",
    "radius_km",
    "projects",
    "overlaps",
    "counts_by_utility",
    "counts_by_band"
  ],
  "title": "Area",
  "type": "object"
}
